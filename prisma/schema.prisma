generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String   @default("")
  email        String   @unique
  password     String
  recoveryCode String?  // хеш 4-значного коду для відновлення пароля
  role         String   @default("user")
  partnerId    String?
  createdAt    DateTime @default(now())

  categories             Category[]       @relation("UserCategories")
  transactions           Transaction[]
  goalsCreated           Goal[]           @relation("GoalCreatedBy")
  partnerInvitesSent     PartnerInvite[]  @relation("PartnerInviteFrom")
  partnerInvitesReceived PartnerInvite[]  @relation("PartnerInviteTo")
  reminders              Reminder[]
  pushSubscriptions      PushSubscription[]
}

// Запрошення до спільного рахунку (підтвердження одержувачем)
model PartnerInvite {
  id             String    @id @default(cuid())
  fromUserId     String
  toUserId       String
  recipientRole  String
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?

  fromUser User @relation("PartnerInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("PartnerInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Category {
  id       String   @id @default(cuid())
  name     String
  userId   String?
  // createdBy: хто створив спільну категорію; userId може бути null
  createdBy String?
  // isSystem: службова категорія, назва не шифрується (пошук за фіксованою назвою)
  isSystem Boolean  @default(false)
  isShared Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User?         @relation("UserCategories", fields: [userId], references: [id], onDelete: SetNull)
  transactions Transaction[]
}

model Transaction {
  id         String   @id @default(cuid())
  amount     Float
  type       String
  categoryId String
  userId     String
  createdAt  DateTime @default(now())
  goalId     String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  goal     Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model Goal {
  id           String    @id @default(cuid())
  title        String
  targetAmount Float
  currentAmount Float    @default(0)
  createdBy    String
  isShared     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  realizedAt   DateTime?

  createdByUser User          @relation("GoalCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  transactions  Transaction[]
}

model Reminder {
  id              String    @id @default(cuid())
  userId          String
  message         String
  time            String    // HH:mm (локальний час користувача)
  startDate       DateTime  @db.Date
  interval        String    // once | daily | weekly | monthly
  timezone        String    @default("Europe/Kyiv")
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
