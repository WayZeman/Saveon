generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String   @default("")
  avatarEmoji  String?
  email        String   @unique
  password     String
  recoveryCode String?  // хеш коду для відновлення пароля (4 або 6 цифр)
  role         String   @default("user")
  partnerId    String?
  partner      User?    @relation("UserPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  partnerOf    User[]   @relation("UserPartner")
  createdAt    DateTime @default(now())

  categories             Category[]       @relation("UserCategories")
  transactions           Transaction[]
  goalsCreated           Goal[]           @relation("GoalCreatedBy")
  partnerInvitesSent     PartnerInvite[]  @relation("PartnerInviteFrom")
  partnerInvitesReceived PartnerInvite[]  @relation("PartnerInviteTo")
}

// Запрошення до спільного рахунку (підтвердження одержувачем)
model PartnerInvite {
  id             String    @id @default(cuid())
  fromUserId     String
  toUserId       String
  recipientRole  String
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?

  fromUser User @relation("PartnerInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("PartnerInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Category {
  id       String   @id @default(cuid())
  name     String
  userId   String?
  // createdBy: хто створив спільну категорію; userId може бути null
  createdBy String?
  // isSystem: службова категорія, назва не шифрується (пошук за фіксованою назвою)
  isSystem Boolean  @default(false)
  isShared Boolean  @default(false)
  // primary = основна (для цілей), secondary = другорядна
  tier     String   @default("primary")
  createdAt DateTime @default(now())

  user              User?         @relation("UserCategories", fields: [userId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  sourceTransactions Transaction[] @relation("TransactionSourceCategory")
  goalSources       GoalSourceCategory[]
  goalId            String?  @unique
  // SetNull: витрата за реалізованою ціллю лишається в історії навіть після видалення цілі
  goal              Goal?    @relation("GoalExpenseCategory", fields: [goalId], references: [id], onDelete: SetNull)
}

model Transaction {
  id               String   @id @default(cuid())
  amount           Float
  type             String
  categoryId       String
  // Для витрат: категорія-джерело, з якої знімаються кошти
  sourceCategoryId String?
  userId           String
  createdAt        DateTime @default(now())
  goalId           String?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sourceCategory Category? @relation("TransactionSourceCategory", fields: [sourceCategoryId], references: [id], onDelete: SetNull)
  goal           Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model Goal {
  id           String    @id @default(cuid())
  title        String
  description  String?
  targetAmount Float
  currentAmount Float    @default(0)
  deadline     DateTime?
  createdBy    String
  isShared     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  realizedAt   DateTime?

  createdByUser User          @relation("GoalCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  sourceCategories GoalSourceCategory[]
  expenseCategory Category? @relation("GoalExpenseCategory")
}

// Категорії, з балансу яких рахується прогрес цілі та з яких списуються кошти при реалізації
model GoalSourceCategory {
  goalId     String
  categoryId String

  goal     Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([goalId, categoryId])
}

