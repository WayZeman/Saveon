# Шаблон змінних середовища — без секретів (це можна комітити в git).
# Як налаштувати:
#   Локально: скопіюйте як .env або .env.local і заповніть значення (ці файли в .gitignore).
#   Vercel: Project → Settings → Environment Variables — додайте ті самі назви змінних і значення там.
# Ніколи не вставляйте справжні SESSION_SECRET / паролі БД у файли, які комітите.

# --- База даних ---
# Локально / SQLite:
DATABASE_URL="file:./dev.db"

# Neon + Vercel (pooler URL для runtime; міграції часто через окремий direct URL — див. доку Neon):
# DATABASE_URL=

# --- Обов’язково на проді (задайте у Vercel Environment Variables або в локальному .env.local) ---
# Мінімум 32 символи. Згенерувати: openssl rand -base64 48
# SESSION_SECRET=

# Опційно; якщо не задано, ключ походить від SESSION_SECRET (не ідеально для продакшену).
# openssl rand -base64 32
# DATA_ENCRYPTION_KEY=

# --- Web Push (сповіщення на телефон) ---
# Згенерувати ключі: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@saveon.app

# Секрет для cron-задачі (Vercel надсилає його автоматично в Authorization)
# openssl rand -base64 32
# CRON_SECRET=
